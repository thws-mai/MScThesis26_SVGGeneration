@misc{rodriguezStarVectorGeneratingScalable2025,
  title = {{{StarVector}}: {{Generating Scalable Vector Graphics Code}} from {{Images}} and {{Text}}},
  shorttitle = {{{StarVector}}},
  author = {Rodriguez, Juan A. and Puri, Abhay and Agarwal, Shubham and Laradji, Issam H. and Rodriguez, Pau and Rajeswar, Sai and Vazquez, David and Pal, Christopher and Pedersoli, Marco},
